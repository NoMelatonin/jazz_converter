{
  "name": "jazz-converter",
  "productName": "Jazz Converter",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Lokale Swing-Arrangements f\u00fcr zwei H\u00e4nde",
  "author": "Jazz Converter",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/notices.mjs && node scripts/pdf-assets.mjs && vite build && node scripts/build-desktop.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:pdf": "node scripts/e2e-pdf.mjs",
    "verify:online": "node scripts/check-online.mjs",
    "verify:package": "node scripts/check-package.mjs",
    "verify:omr": "node scripts/check-omr.mjs",
    "fixtures:pdf": "node scripts/pdf-fixtures.mjs",
    "verify:pdf": "node scripts/check-pdf-matrix.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "omr:assets": "node scripts/fetch-omr.mjs && node scripts/patch-omr.mjs",
    "omr:patch": "node scripts/patch-omr.mjs",
    "icon": "node scripts/make-icon.mjs",
    "previews": "node scripts/listening.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:local": "npm run build && node scripts/package.mjs --local",
    "test:e2e:video": "node scripts/e2e-video.mjs",
    "test:e2e:versions": "node scripts/e2e-versions.mjs"
  },
  "build": {
    "appId": "de.jazzconverter.app",
    "productName": "Jazz Converter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": ["dist-electron/video/**"],
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "category": "public.app-category.music",
      "icon": "public/icon.icns",
      "minimumSystemVersion": "14.0.0",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "fast-xml-parser": "5.12.0",
    "fflate": "0.8.3",
    "lucide-react": "1.68.0",
    "midi-file": "1.2.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
